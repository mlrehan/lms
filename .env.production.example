# =============================================================================
# LMS PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to `.env.production` on your production server.
# Generate secrets using `openssl` or `./scripts/generate-keys.sh`.
# =============================================================================

# -----------------------------------------------------------------------------
# APPLICATION CORE
# -----------------------------------------------------------------------------
APP_ENVIRONMENT=production
APP_NAME=LMS
APP_VERSION=1.0.0
APP_DEBUG=false

# -----------------------------------------------------------------------------
# HTTP SERVER & REVERSE PROXY
# -----------------------------------------------------------------------------
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
# Comma-separated list of IP addresses / CIDRs trusted by the ASGI server for proxy headers.
# 172.16.0.0/12 covers standard Docker bridge networks.
SERVER_FORWARDED_ALLOW_IPS=127.0.0.1,172.16.0.0/12,10.0.0.0/8

# -----------------------------------------------------------------------------
# API ROUTING, CORS & TRUSTED HOSTS
# Replace `your-domain.com` with your registered domain name.
# Note: In production, wildcards (*) and localhost are strictly forbidden.
# -----------------------------------------------------------------------------
API_PREFIX=/api/v1
API_CORS_ORIGINS=https://your-domain.com
API_TRUSTED_HOSTS=your-domain.com,backend

# -----------------------------------------------------------------------------
# DATABASE (PostgreSQL)
# Two-tier database credentials:
# 1. lms_migrator: Schema owner used by Alembic migrations (DDL permissions)
# 2. lms_runtime: Used by FastAPI runtime application (least-privilege DML permissions)
# -----------------------------------------------------------------------------
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_NAME=lms_db

# Alembic Migration User (DDL)
DATABASE_MIGRATION_USER=lms_migrator
DATABASE_MIGRATION_PASSWORD=GENERATE_STRONG_MIGRATOR_PASSWORD_HERE

# Application Runtime User (DML)
DATABASE_RUNTIME_USER=lms_runtime
DATABASE_RUNTIME_PASSWORD=GENERATE_STRONG_RUNTIME_PASSWORD_HERE

# In production, DATABASE_SSL_MODE must be `require`, `verify-ca`, or `verify-full`.
# The included docker-compose postgres generates self-signed TLS certs on startup to satisfy `require`.
DATABASE_SSL_MODE=require
DATABASE_ECHO_SQL=false

# -----------------------------------------------------------------------------
# CACHE & REALTIME EVENT BUS (Redis)
# Required in production: REALTIME_BACKEND must be `redis`
# -----------------------------------------------------------------------------
REDIS_PASSWORD=GENERATE_STRONG_REDIS_PASSWORD_HERE
REALTIME_ENABLED=true
REALTIME_BACKEND=redis
REALTIME_REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379/0

# -----------------------------------------------------------------------------
# SECURITY & CRYPTOGRAPHY
# -----------------------------------------------------------------------------
# JWT Signing Secret (must be at least 32 characters)
# Generate with: openssl rand -hex 32
SECURITY_JWT_SECRET=GENERATE_32_BYTE_HEX_JWT_SECRET_HERE

# Master Envelope Encryption Key (must decode to exactly 32 bytes Base64)
# Generate with: openssl rand -base64 32
SECURITY_MASTER_ENCRYPTION_KEY=GENERATE_32_BYTE_BASE64_KEY_HERE

# -----------------------------------------------------------------------------
# PERSISTENT FILE STORAGE
# Mode: 'local' (mounted at /app/var/storage) or 'r2' (Cloudflare R2)
# -----------------------------------------------------------------------------
STORAGE_MODE=local
STORAGE_LOCAL_PATH=/app/var/storage
STORAGE_MAX_UPLOAD_BYTES=104857600

# Optional Cloudflare R2 settings (only if STORAGE_MODE=r2):
# STORAGE_R2_ACCOUNT_ID=
# STORAGE_R2_BUCKET=
# STORAGE_R2_ACCESS_KEY_ID=
# STORAGE_R2_SECRET_ACCESS_KEY=

# -----------------------------------------------------------------------------
# WEB PUSH NOTIFICATIONS (VAPID)
# Generate a keypair with: python -m backend.cli.generate_vapid_keys
# Leave blank to disable push notifications.
# -----------------------------------------------------------------------------
PUSH_VAPID_PUBLIC_KEY=
PUSH_VAPID_PRIVATE_KEY=
PUSH_SUBJECT=mailto:admin@your-domain.com

# -----------------------------------------------------------------------------
# EMAIL / SMTP (Optional)
# If MAIL_ENABLED=true, MAIL_SUPPRESS_SEND must be false in production.
# -----------------------------------------------------------------------------
MAIL_ENABLED=false
MAIL_SERVER=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@your-domain.com
MAIL_TLS=true
MAIL_SSL=false
MAIL_SUPPRESS_SEND=false
MAIL_APP_URL=https://your-domain.com

# -----------------------------------------------------------------------------
# EXTERNAL LAIT SYSTEM SYNCHRONIZATION
# -----------------------------------------------------------------------------
LAIT_API_BASE_URL=https://api.londonacademyofit.co.uk
LAIT_API_KEY=leTk0x3uoi1sRhPQFNvX86bw9VWMqjtm

# -----------------------------------------------------------------------------
# GOOGLE CALENDAR INTEGRATION (Optional)
# -----------------------------------------------------------------------------
GOOGLE_EMAIL=your_google_email@example.com
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=https://your-domain.com/integrations/google/callback

# -----------------------------------------------------------------------------
# INITIAL SUPERADMIN BOOTSTRAP PASSWORD
# Used only during initial database seed (`python -m backend.cli.seed`)
# -----------------------------------------------------------------------------
LMS_ADMIN_PASSWORD=GENERATE_STRONG_ADMIN_PASSWORD_HERE

# -----------------------------------------------------------------------------
# STRUCTURED LOGGING
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=json

# -----------------------------------------------------------------------------
# ENTERPRISE MULTI-AGENT AI ECOSYSTEM (Phase 1-8)
# -----------------------------------------------------------------------------
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o
OPENAI_INTENT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_TRANSCRIPTION_MODEL=whisper-1
# Per-person request limits on the assistant (each turn is a paid OpenAI call).
AI_CHAT_REQUESTS_PER_MINUTE=20
AI_TRANSCRIBE_REQUESTS_PER_MINUTE=6
AI_MAX_AUDIO_BYTES=26214400
# Days an assistant conversation is kept before it is deleted.
AI_CONVERSATION_RETENTION_DAYS=30
# Read-only PostgreSQL role for the Super Admin's SQL tool. Create or refresh it
# (and re-run after every migration that adds a table) with:
#   docker compose run --rm backend python -m backend.cli.create_ai_readonly_role
# With no password the SQL tool refuses to run.
AI_SQL_READONLY_USERNAME=lms_ai_readonly
AI_SQL_READONLY_PASSWORD=CHANGE_ME_long_random_value
# Most rows one confirmed SQL change may affect. Changes also require a backup
# no older than APP_SYSTEM_RESET_BACKUP_MAX_AGE_HOURS at APP_SYSTEM_RESET_BACKUP_PATH.
AI_SQL_MAX_WRITE_ROWS=500
# Course-material index for the assistant's search. Runs inside the API process
# every AI_RAG_INDEX_INTERVAL_SECONDS; each pass embeds up to AI_RAG_INDEX_BATCH_SIZE
# new or changed files (text, Markdown, CSV, PDF, .docx) with OPENAI_EMBEDDING_MODEL.
# That is a paid OpenAI call per file. Changing the embedding model re-indexes everything.
AI_RAG_INDEXING_ENABLED=true
AI_RAG_INDEX_INTERVAL_SECONDS=120
AI_RAG_INDEX_BATCH_SIZE=10
AI_RAG_MAX_FILE_BYTES=20971520
AI_RAG_MAX_CHUNKS_PER_RESOURCE=300


